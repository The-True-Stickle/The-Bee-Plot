---
const { url, title, description, imagePath, altText, pubDate } = Astro.props;
import BlogImageComponent from '../components/BlogImageComponent.astro'
---
<li>
    <BlogImageComponent imagePath={imagePath} altText={altText} />
    <p>{description}</p>
    <a href={url}>{title}</a>
    <time datetime={pubDate}>{pubDate.toString().slice(0,10)}</time>


</li>