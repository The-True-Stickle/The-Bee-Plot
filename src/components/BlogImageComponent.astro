---
// Reference - https://docs.astro.build/en/recipes/dynamically-importing-images/ , https://docs.astro.build/en/guides/images/

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
    imagePath: string;
    altText: string;
}

const { imagePath, altText } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/blog-images/*.{jpeg,jpg,png,gif}')
if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/blog-images/*.{jpeg,jpg,png,gif}"`);
---

<Image src={images[imagePath]()} alt={altText} />